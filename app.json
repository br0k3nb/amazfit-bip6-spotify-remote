{
  "configVersion": "v3",
  "app": {
    "appId": 26263,
    "appName": "Spotify Control",
    "appType": "app",
    "version": {
      "code": 11,
      "name": "1.6.0"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "Control Spotify playback from Bip 6"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "debug": false,
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/gt/home/index.page",
            "page/gt/playlists/index.page",
            "page/gt/tracks/index.page",
            "page/gt/search/index.page",
            "page/gt/queue/index.page",
            "page/gt/cover/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "s"
        }
      ],
      "designWidth": 390
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Spotify Control"
    },
    "zh-CN": {
      "appName": "Spotify Control"
    }
  },
  "defaultLanguage": "en-US"
}
